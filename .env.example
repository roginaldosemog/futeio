# Copy to .env.firebase (ignored). Do not overwrite the older branch's .env.
FUTEIO_FIREBASE_MODE=emulator
FIREBASE_PROJECT_ID=demo-futeio
GCLOUD_PROJECT=demo-futeio
FIREBASE_STORAGE_BUCKET=demo-futeio.firebasestorage.app
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_WEB_API_KEY=demo-emulator-key
FIREBASE_ADMIN_UID=futeio-emulator-admin
ADMIN_EMAIL=e2e-admin@example.test
AUTH_SECRET=local-emulator-secret-change-before-real-use-000000
APP_ORIGIN=http://localhost:3000
# For a REAL project: mode=production, no emulator host vars, HTTPS origin,
# explicit project/admin UID/email/API key, new random AUTH_SECRET.
# Configure secrets only on the server; see docs/firebase.md for production:
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# BLOB_READ_WRITE_TOKEN=...
# CRON_SECRET=...
# Never prefix these server settings with NEXT_PUBLIC_.
