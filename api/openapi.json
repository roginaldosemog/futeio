{
  "components": {
    "schemas": {
      "AdminPasswordLoginDto": {
        "properties": {
          "email": {
            "example": "admin@example.test",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "CsrfResponseDto": {
        "properties": {
          "csrfToken": {
            "description": "CSRF header value bound to the current HttpOnly browser cookie.",
            "type": "string"
          }
        },
        "required": [
          "csrfToken"
        ],
        "type": "object"
      },
      "MessageResponseDto": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "SessionResponseDto": {
        "properties": {
          "email": {
            "description": "Only the authenticated administrator’s own email.",
            "type": "string"
          },
          "groupId": {
            "format": "uuid",
            "type": "string"
          },
          "identityId": {
            "format": "uuid",
            "type": "string"
          },
          "playerId": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": [
              "ADMIN",
              "PLAYER"
            ],
            "type": "string"
          }
        },
        "required": [
          "role",
          "identityId",
          "groupId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "futeio_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Closed-group football organization. Administrator access is available in E2.",
    "title": "Futeio API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/admin/login": {
      "post": {
        "operationId": "AccessController_login",
        "parameters": [
          {
            "in": "header",
            "name": "x-csrf-token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminPasswordLoginDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponseDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": ""
          },
          "401": {
            "description": ""
          },
          "403": {
            "description": ""
          },
          "429": {
            "description": ""
          }
        },
        "tags": [
          "Access"
        ]
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "AccessController_csrf",
