generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships Membership[]
  draws Draw[]

  @@map("groups")
}

enum MembershipRole {
  ADMIN
  PLAYER
}

enum SessionRole {
  ANONYMOUS
  ADMIN
  PLAYER
}

model Identity {
  id          String       @id @default(uuid()) @db.Uuid
  email       String?      @unique @db.VarChar(254)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships Membership[]

  @@map("identities")
}

model Membership {
  groupId    String         @map("group_id") @db.Uuid
  identityId String         @map("identity_id") @db.Uuid
  role       MembershipRole
  group      Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  identity   Identity       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  sessions   AccessSession[]
  loginLinks AdminLoginLink[]
  player Player?
  evaluations Evaluation[] @relation("EvaluationAuthor")

  @@id([groupId, identityId])
  @@map("memberships")
}

model AccessSession {
  id          String        @id @default(uuid()) @db.Uuid
  tokenHash   String        @unique @map("token_hash") @db.Char(64)
  role        SessionRole
  groupId     String?       @map("group_id") @db.Uuid
  identityId  String?       @map("identity_id") @db.Uuid
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(3)
  credentialVersion String? @map("credential_version") @db.Char(64)
  playerCredentialId String? @map("player_credential_id") @db.Uuid
  playerCredential PlayerAccessCredential? @relation(fields: [playerCredentialId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  membership  Membership?   @relation(fields: [groupId, identityId], references: [groupId, identityId], onDelete: Cascade)
  loginLinks  AdminLoginLink[]

  @@index([expiresAt])
  @@index([playerCredentialId])
  @@map("access_sessions")
}

model AdminLoginLink {
  id               String        @id @default(uuid()) @db.Uuid
  tokenHash        String        @unique @map("token_hash") @db.Char(64)
  groupId          String        @map("group_id") @db.Uuid
  identityId       String        @map("identity_id") @db.Uuid
  requestSessionId String        @map("request_session_id") @db.Uuid
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt           DateTime?     @map("used_at") @db.Timestamptz(3)
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  membership       Membership    @relation(fields: [groupId, identityId], references: [groupId, identityId], onDelete: Cascade)
  requestSession   AccessSession @relation(fields: [requestSessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_login_links")
}

model AuthRateLimit {
  id        String   @id @db.Char(64)
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model Player {
  id         String     @id @default(uuid()) @db.Uuid
  groupId    String     @map("group_id") @db.Uuid
  identityId String     @map("identity_id") @db.Uuid
  name       String     @db.VarChar(100)
  photoBytes Bytes?     @map("photo_bytes")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  membership Membership @relation(fields: [groupId, identityId], references: [groupId, identityId], onDelete: Cascade)
  evaluations Evaluation[]
  credentials PlayerAccessCredential[]

  @@unique([groupId, identityId])
  @@unique([groupId, id])
  @@map("players")
}

model Evaluation {
  groupId             String @map("group_id") @db.Uuid
  playerId            String @map("player_id") @db.Uuid
  evaluatorIdentityId String @map("evaluator_identity_id") @db.Uuid
  rating              Int    @db.SmallInt
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  player              Player @relation(fields: [groupId, playerId], references: [groupId, id], onDelete: Cascade)
  evaluator           Membership @relation("EvaluationAuthor", fields: [groupId, evaluatorIdentityId], references: [groupId, identityId], onDelete: Cascade)

  @@id([groupId, playerId, evaluatorIdentityId])
  @@index([groupId, evaluatorIdentityId])
  @@map("evaluations")
}

model PlayerAccessCredential {
  id        String @id @default(uuid()) @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  playerId  String @map("player_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  player    Player @relation(fields: [groupId, playerId], references: [groupId, id], onDelete: Cascade)
  sessions AccessSession[]

  @@index([groupId, playerId])
  @@map("player_access_credentials")
}

model Draw {
  id                 String   @id @default(uuid()) @db.Uuid
  groupId            String   @map("group_id") @db.Uuid
  createdBy          String   @map("created_by") @db.Uuid
  seed               String   @db.VarChar(64)
  algorithmVersion   String   @map("algorithm_version") @db.VarChar(64)
  calculationVersion String   @map("calculation_version") @db.VarChar(64)
  snapshot           Json
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  group              Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("draws")
}
