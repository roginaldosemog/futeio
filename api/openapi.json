{
  "components": {
    "schemas": {
      "AdminPasswordLoginDto": {
        "properties": {
          "email": {
            "example": "admin@example.test",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "CreatePlayerDto": {
        "properties": {
          "initialRating": {
            "example": 7,
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          },
          "linkToCurrentAdministrator": {
            "default": false,
            "description": "Link this profile to the authenticated administrator identity.",
            "type": "boolean"
          },
          "name": {
            "example": "Jogador de exemplo",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "initialRating"
        ],
        "type": "object"
      },
      "CreatePlayerResponseDto": {
        "properties": {
          "accessUrl": {
            "description": "Personal access credential, returned only at creation. Never returned in listings.",
            "type": "string"
          },
          "player": {
            "$ref": "#/components/schemas/PlayerSummaryDto"
          }
        },
        "required": [
          "player",
          "accessUrl"
        ],
        "type": "object"
      },
      "CsrfResponseDto": {
        "properties": {
          "csrfToken": {
            "description": "CSRF header value bound to the current HttpOnly browser cookie.",
            "type": "string"
          }
        },
        "required": [
          "csrfToken"
        ],
        "type": "object"
      },
      "MessageResponseDto": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "PlayerSummaryDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isOwnProfile": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "rating": {
            "description": "Initial contribution in E3; consolidated rating is introduced in E6.",
            "maximum": 10,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "rating",
          "isOwnProfile"
        ],
        "type": "object"
      },
      "SessionResponseDto": {
        "properties": {
          "email": {
            "description": "Only the authenticated administrator’s own email.",
            "type": "string"
          },
          "groupId": {
            "format": "uuid",
            "type": "string"
          },
          "identityId": {
            "format": "uuid",
            "type": "string"
          },
          "playerId": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": [
              "ADMIN",
              "PLAYER"
            ],
            "type": "string"
          }
        },
        "required": [
          "role",
          "identityId",
          "groupId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "futeio_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Closed-group football organization. Administrator access is available in E2.",
    "title": "Futeio API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/admin/login": {
      "post": {
        "operationId": "AccessController_login",
        "parameters": [
          {
            "in": "header",
            "name": "x-csrf-token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminPasswordLoginDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponseDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": ""
          },
          "401": {
            "description": ""
          },
          "403": {
            "description": ""
          },
          "429": {
            "description": ""
          }
        },
        "tags": [
          "Access"
        ]
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "AccessController_csrf",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponseDto"
                }
              }
            },
            "description": ""
          },
          "429": {
            "description": ""
          }
        },
        "tags": [
          "Access"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AccessController_logout",
        "parameters": [
          {
            "in": "header",
            "name": "x-csrf-token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponseDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": ""
          },
          "403": {
            "description": ""
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "Access"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AccessController_me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponseDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": ""
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "Access"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "HealthController_liveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "HealthController_readiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/players": {
      "get": {
        "operationId": "PlayersController_list",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PlayerSummaryDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": ""
          },
          "403": {
            "description": ""
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "tags": [
          "Players"
        ]
      },
      "post": {
        "operationId": "PlayersController_create",
        "parameters": [
          {
            "in": "header",
            "name": "x-csrf-token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePlayerDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePlayerResponseDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "description": ""
          },
          "401": {
            "description": ""
          },
          "403": {
            "description": ""
          },
          "409": {
            "description": ""
          }
        },
        "security": [
          {
