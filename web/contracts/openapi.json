{
  "components": {
    "schemas": {
      "AdminPasswordLoginDto": {
        "properties": {
          "email": {
            "example": "admin@example.test",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "CreateDrawDto": {
        "properties": {
          "playerIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 20,
            "type": "array",
            "uniqueItems": true
          },
          "seed": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "playerIds"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "CreatePlayerDto": {
        "properties": {
          "initialRating": {
            "example": 7,
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          },
          "linkToCurrentAdministrator": {
            "default": false,
            "description": "Link this profile to the authenticated administrator identity.",
            "type": "boolean"
          },
          "name": {
            "example": "Jogador de exemplo",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "initialRating"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "CreatePlayerResponseDto": {
        "properties": {
          "accessUrl": {
            "description": "Personal access credential, returned only at creation. Never returned in listings.",
            "type": "string"
          },
          "player": {
            "$ref": "#/components/schemas/PlayerSummaryDto"
          }
        },
        "required": [
          "player",
          "accessUrl"
        ],
        "type": "object"
      },
      "CsrfResponseDto": {
        "properties": {
          "csrfToken": {
            "description": "CSRF header value bound to the current HttpOnly browser cookie.",
            "type": "string"
          }
        },
        "required": [
          "csrfToken"
        ],
        "type": "object"
      },
      "DrawDto": {
        "properties": {
          "algorithmVersion": {
            "type": "string"
          },
          "calculationVersion": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "seed": {
            "type": "string"
          },
          "spread": {
            "type": "number"
          },
          "teams": {
            "items": {
              "$ref": "#/components/schemas/DrawTeamDto"
            },
            "type": "array"
          },
          "variance": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "createdAt",
          "seed",
          "algorithmVersion",
          "calculationVersion",
          "teams",
          "spread",
          "variance"
        ],
        "type": "object"
      },
      "DrawPlayerDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "rating"
        ],
        "type": "object"
      },
      "DrawTeamDto": {
        "properties": {
          "average": {
            "type": "number"
          },
          "number": {
            "maximum": 4,
            "minimum": 1,
            "type": "integer"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/DrawPlayerDto"
            },
            "type": "array"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "number",
          "players",
          "total",
          "average"
        ],
        "type": "object"
      },
      "EvaluatePlayerDto": {
        "properties": {
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "rating"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "EvaluationRowDto": {
        "properties": {
          "authorName": {
            "description": "Only the administrator or the author receives the author name.",
            "type": "string"
          },
          "isOwn": {
            "type": "boolean"
          },
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "rating",
          "isOwn"
        ],
        "type": "object"
      },
      "MessageResponseDto": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "PlayerAccessLinkDto": {
        "properties": {
          "accessUrl": {
            "description": "Personal access credential returned once; previous links and sessions are revoked.",
            "type": "string"
          }
        },
        "required": [
          "accessUrl"
        ],
        "type": "object"
      },
      "PlayerEvaluationsDto": {
        "properties": {
          "calculationVersion": {
            "type": "string"
          },
          "discardedPerSide": {
            "enum": [
              0,
              1,
              2
            ],
            "type": "integer"
          },
          "evaluationCount": {
            "minimum": 1,
            "type": "integer"
          },
          "evaluations": {
            "items": {
              "$ref": "#/components/schemas/EvaluationRowDto"
            },
            "type": "array"
          },
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "evaluations",
          "rating",
          "evaluationCount",
          "discardedPerSide",
          "calculationVersion"
        ],
        "type": "object"
      },
      "PlayerProfileDto": {
        "properties": {
          "canEdit": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isOwnProfile": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "photoUrl": {
            "description": "Private photo endpoint; requires an active group session.",
            "type": "string"
          },
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "rating",
          "isOwnProfile",
          "canEdit"
        ],
        "type": "object"
      },
      "PlayerSummaryDto": {
        "properties": {
          "evaluationCount": {
            "minimum": 1,
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isOwnProfile": {
            "type": "boolean"
          },
          "myRating": {
            "nullable": true,
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "photoUrl": {
            "type": "string"
          },
          "rating": {
            "description": "Consolidated rating without presentation rounding.",
            "maximum": 10,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "rating",
          "isOwnProfile"
        ],
        "type": "object"
      },
      "RedeemPlayerLinkDto": {
        "properties": {
          "token": {
            "maxLength": 43,
            "minLength": 43,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "SessionResponseDto": {
        "properties": {
          "email": {
            "description": "Only the authenticated administrator’s own email.",
            "type": "string"
          },
          "groupId": {
            "format": "uuid",
            "type": "string"
          },
          "identityId": {
            "format": "uuid",
            "type": "string"
          },
          "playerId": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": [
              "ADMIN",
              "PLAYER"
            ],
            "type": "string"
          }
        },
        "required": [
          "role",
          "identityId",
          "groupId"
        ],
        "type": "object"
      },
      "UpdatePlayerProfileDto": {
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "UploadPlayerPhotoDto": {
        "properties": {
          "data": {
            "description": "Base64 JPEG or PNG bytes, at most 2 MiB decoded. No data URL prefix.",
            "maxLength": 2796204,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "data"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "AdminGoogleLoginDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "idToken"
        ],
        "properties": {
          "idToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "writeOnly": true,
            "description": "Fresh Firebase ID token from Google sign-in. Never persist or log."
          }
        }
      },
      "NativeSessionResponseDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "minLength": 43,
            "maxLength": 43,
            "description": "Opaque native session credential. Store only in the device secure store; never logs, navigation or query cache."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "session": {
            "$ref": "#/components/schemas/SessionResponseDto"
          }
        },
        "required": [
          "token",
          "expiresAt",
          "session"
        ]
      },
      "NativeAuthorizeDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "codeChallenge": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "minLength": 43,
            "maxLength": 43,
            "description": "S256 PKCE challenge derived from a verifier retained by the native app."
          },
          "state": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "codeChallenge",
          "state"
        ]
      },
      "NativeAuthorizeResponseDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "redirectUrl": {
            "type": "string",
            "description": "Fixed futeio://auth/callback URI containing a one-use code and matching state. Never accepts a caller-supplied redirect URI."
          }
        },
        "required": [
          "redirectUrl"
        ]
      },
      "NativeExchangeDto": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "minLength": 43,
            "maxLength": 43
          },
          "codeVerifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._~-]{43,128}$",
            "minLength": 43,
            "maxLength": 128
          },
          "state": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "minLength": 43,
            "maxLength": 43
          }
        },
        "required": [
          "code",
          "codeVerifier",
          "state"
        ]
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "futeio_session",
        "type": "apiKey"
      },
      "nativeSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Opaque native session only. Browser cookie sessions cannot be used as Bearer tokens."
      },
      "nativeClient": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Futeio-Client",
        "description": "Value must be native. This is a transport marker, not an authentication secret. Native requests must omit Cookie and Origin."
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Private group REST API shared by website and native apps. Browser mutations require exact Origin and CSRF with HttpOnly cookies. Native requests require X-Futeio-Client: native, no Cookie/Origin, and an opaque Bearer session for protected resources. Session transports cannot be mixed or substituted. Firebase and Blob credentials stay server-side.",
    "title": "fute.io Website API",
    "version": "0.2.0"
  },
  "openapi": "3.0.0",
