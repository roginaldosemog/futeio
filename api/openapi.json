{
  "components": {
    "schemas": {
      "AdminPasswordLoginDto": {
        "properties": {
          "email": {
            "example": "admin@example.test",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 256,
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "CreateDrawDto": {
        "properties": {
          "playerIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 20,
            "type": "array",
            "uniqueItems": true
          },
          "seed": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "playerIds"
        ],
        "type": "object"
      },
      "CreatePlayerDto": {
        "properties": {
          "initialRating": {
            "example": 7,
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          },
          "linkToCurrentAdministrator": {
            "default": false,
            "description": "Link this profile to the authenticated administrator identity.",
            "type": "boolean"
          },
          "name": {
            "example": "Jogador de exemplo",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "initialRating"
        ],
        "type": "object"
      },
      "CreatePlayerResponseDto": {
        "properties": {
          "accessUrl": {
            "description": "Personal access credential, returned only at creation. Never returned in listings.",
            "type": "string"
          },
          "player": {
            "$ref": "#/components/schemas/PlayerSummaryDto"
          }
        },
        "required": [
          "player",
          "accessUrl"
        ],
        "type": "object"
      },
      "CsrfResponseDto": {
        "properties": {
          "csrfToken": {
            "description": "CSRF header value bound to the current HttpOnly browser cookie.",
            "type": "string"
          }
        },
        "required": [
          "csrfToken"
        ],
        "type": "object"
      },
      "DrawDto": {
        "properties": {
          "algorithmVersion": {
            "type": "string"
          },
          "calculationVersion": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "seed": {
            "type": "string"
          },
          "spread": {
            "type": "number"
          },
          "teams": {
            "items": {
              "$ref": "#/components/schemas/DrawTeamDto"
            },
            "type": "array"
          },
          "variance": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "createdAt",
          "seed",
          "algorithmVersion",
          "calculationVersion",
          "teams",
          "spread",
          "variance"
        ],
        "type": "object"
      },
      "DrawPlayerDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "rating"
        ],
        "type": "object"
      },
      "DrawTeamDto": {
        "properties": {
          "average": {
            "type": "number"
          },
          "number": {
            "maximum": 4,
            "minimum": 1,
            "type": "integer"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/DrawPlayerDto"
            },
            "type": "array"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "number",
          "players",
          "total",
          "average"
        ],
        "type": "object"
      },
      "EvaluatePlayerDto": {
        "properties": {
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "rating"
        ],
        "type": "object"
      },
      "EvaluationRowDto": {
        "properties": {
          "authorName": {
            "description": "Only the administrator or the author receives the author name.",
            "type": "string"
          },
          "isOwn": {
            "type": "boolean"
          },
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "rating",
          "isOwn"
        ],
        "type": "object"
      },
      "MessageResponseDto": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "PlayerAccessLinkDto": {
        "properties": {
          "accessUrl": {
            "description": "Personal access credential returned once; previous links and sessions are revoked.",
            "type": "string"
          }
        },
        "required": [
          "accessUrl"
        ],
        "type": "object"
      },
      "PlayerEvaluationsDto": {
        "properties": {
          "calculationVersion": {
            "type": "string"
          },
          "discardedPerSide": {
            "enum": [
              0,
              1,
              2
            ],
            "type": "integer"
          },
          "evaluationCount": {
            "minimum": 1,
            "type": "integer"
          },
          "evaluations": {
            "items": {
              "$ref": "#/components/schemas/EvaluationRowDto"
            },
            "type": "array"
          },
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "evaluations",
          "rating",
          "evaluationCount",
          "discardedPerSide",
          "calculationVersion"
        ],
        "type": "object"
      },
      "PlayerProfileDto": {
        "properties": {
          "canEdit": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isOwnProfile": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "photoUrl": {
            "description": "Private photo endpoint; requires an active group session.",
            "type": "string"
          },
          "rating": {
            "maximum": 10,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "rating",
          "isOwnProfile",
          "canEdit"
        ],
        "type": "object"
      },
      "PlayerSummaryDto": {
        "properties": {
          "evaluationCount": {
            "minimum": 1,
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isOwnProfile": {
            "type": "boolean"
          },
          "myRating": {
            "nullable": true,
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "photoUrl": {
            "type": "string"
          },
          "rating": {
            "description": "Consolidated rating without presentation rounding.",
            "maximum": 10,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "rating",
          "isOwnProfile"
        ],
        "type": "object"
      },
      "RedeemPlayerLinkDto": {
        "properties": {
          "token": {
            "maxLength": 43,
            "minLength": 43,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "SessionResponseDto": {
        "properties": {
          "email": {
            "description": "Only the authenticated administrator’s own email.",
            "type": "string"
          },
          "groupId": {
            "format": "uuid",
            "type": "string"
          },
          "identityId": {
            "format": "uuid",
            "type": "string"
          },
          "playerId": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": [
              "ADMIN",
              "PLAYER"
            ],
            "type": "string"
          }
        },
        "required": [
          "role",
          "identityId",
          "groupId"
        ],
        "type": "object"
      },
      "UpdatePlayerProfileDto": {
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "UploadPlayerPhotoDto": {
        "properties": {
          "data": {
            "description": "Base64 JPEG or PNG bytes, at most 2 MiB decoded. No data URL prefix.",
            "maxLength": 2796204,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "futeio_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Private football group: player access, profiles, current evaluations and recorded team draws.",
    "title": "Futeio API",
    "version": "0.1.0"
  },
