# Somente desenvolvimento local. Substituir por segredos próprios em outros ambientes.
POSTGRES_USER=futeio
POSTGRES_PASSWORD=futeio_dev_password
POSTGRES_DB=futeio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://futeio:futeio_dev_password@127.0.0.1:5432/futeio?schema=public

TEST_POSTGRES_USER=futeio_test
TEST_POSTGRES_PASSWORD=futeio_test_password
TEST_POSTGRES_DB=futeio_test
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL=postgresql://futeio_test:futeio_test_password@127.0.0.1:5433/futeio_test?schema=public

API_PORT=3001
API_HOST=127.0.0.1
# Encaminhamento no servidor Next; não usar prefixo NEXT_PUBLIC.
API_ORIGIN=http://127.0.0.1:3001

# E2: acesso administrativo. Configure antes de iniciar a API.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
APP_ORIGIN=http://localhost:3000
# Envio adiado: nenhuma chave de e-mail é necessária nesta entrega.
# RESEND_FROM=Futeio <onboarding@resend.dev>
# RESEND_API_KEY=
# Gere com node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
